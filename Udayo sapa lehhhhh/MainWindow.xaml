<Window x:Class="Udayo_sapa_lehhhhh.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Snake and Ladders" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Grid>

        <!-- ======================= GAME SCREEN ======================= -->
        <Grid x:Name="GameRootGrid" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#2A2A3D"
                    CornerRadius="8"
                    Margin="20"
                    Padding="10">
                <Viewbox Stretch="Uniform">
                    <Grid x:Name="BoardContainer"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid x:Name="BoardGrid" />
                        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
                        <Canvas x:Name="TokenGrid" IsHitTestVisible="False" />
                    </Grid>
                </Viewbox>
            </Border>

            <Border Grid.Column="1"
                    Background="#2A2A3D"
                    CornerRadius="8"
                    Margin="0,20,20,20"
                    Padding="15">
                <StackPanel>
                    <TextBlock Text="SNAKE &amp; LADDERS"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <TextBlock Text="CURRENT TURN"
                               FontSize="11"
                               Foreground="#888899"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurrentPlayerText"
                               Text="Player 1"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15" />

                    <Border x:Name="DiceBorder"
                            Width="80" Height="80"
                            Background="White"
                            CornerRadius="14"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.5" />
                        </Border.Effect>
                        <TextBlock x:Name="DiceValueText"
                                   Text="1"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="#1E1E2E"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Button x:Name="RollDiceButton"
                            Content="ROLL DICE"
                            FontSize="14"
                            FontWeight="Bold"
                            Padding="10"
                            Margin="0,0,0,15"
                            Background="#4A90D9"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="RollDiceButton_Click" />

                    <TextBlock Text="STATUS"
                               FontSize="11"
                               Foreground="#888899"
                               Margin="0,0,0,5" />
                    <TextBlock x:Name="StatusText"
                               Text="Player 1's turn"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20" />

                    <TextBlock Text="PLAYERS"
                               FontSize="11"
                               Foreground="#888899"
                               Margin="0,0,0,8" />
                    <StackPanel x:Name="PlayerListPanel" />

                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================= MAIN MENU ======================= -->
        <Grid x:Name="MenuOverlay" Background="#1E1E2E">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <TextBlock Text="SNAKE &amp; LADDERS"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Text="Choose number of players"
                           FontSize="14"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Button x:Name="TwoPlayersButton" Content="2 PLAYERS" Tag="2"
                            Width="120" Padding="10" Margin="5"
                            Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="PlayerCountButton_Click" />
                    <Button x:Name="ThreePlayersButton" Content="3 PLAYERS" Tag="3"
                            Width="120" Padding="10" Margin="5"
                            Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="PlayerCountButton_Click" />
                    <Button x:Name="FourPlayersButton" Content="4 PLAYERS" Tag="4"
                            Width="120" Padding="10" Margin="5"
                            Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="PlayerCountButton_Click" />
                </StackPanel>

                <Button x:Name="PlayButton" Content="PLAY GAME"
                        FontSize="16" FontWeight="Bold" Padding="12"
                        Background="#4A90D9" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,0,15"
                        Click="PlayButton_Click" />

                <Button x:Name="ExitMenuButton" Content="EXIT"
                        FontSize="14" Padding="8"
                        Background="#3A3A52" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="ExitButton_Click" />
            </StackPanel>
        </Grid>

        <!-- ======================= GAME OVER OVERLAY ======================= -->
        <Grid x:Name="GameOverOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Background="#2A2A3D" CornerRadius="12"
                    Width="380" Padding="25"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="WinnerText"
                               Text="🏆 PLAYER 1 WINS!"
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20" />

                    <TextBlock x:Name="StatsText"
                               Text=""
                               FontSize="13"
                               Foreground="#CCCCCC"
                               TextWrapping="Wrap"
                               Margin="0,0,0,25" />

                    <Button Content="PLAY AGAIN"
                            FontSize="14" FontWeight="Bold" Padding="10"
                            Background="#4A90D9" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Margin="0,0,0,10"
                            Click="PlayAgainButton_Click" />

                    <Button Content="MAIN MENU"
                            FontSize="14" Padding="10"
                            Background="#3A3A52" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Margin="0,0,0,10"
                            Click="MainMenuButton_Click" />

                    <Button Content="EXIT"
                            FontSize="14" Padding="10"
                            Background="#C62828" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="ExitButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>